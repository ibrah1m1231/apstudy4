{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apstudies",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // Cloudflare's AI service. This binding IS the credential — the platform
  // authorises the Worker itself, so there is no key to store anywhere.
  "ai": {
    "binding": "AI"
  },

  // The site's files. Everything the Worker does not handle is served from here.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
